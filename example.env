# Copy this file to .env before running docker compose.

# PostgreSQL used by the backend through Docker DNS.
# There is no default password: compose refuses to start without one, so a
# deployment cannot silently end up with a value published in this repository.
# Generate with: openssl rand -hex 32 — this value is interpolated into
# DATABASE_URL, so it must be URL-safe: a base64 password containing / + = or @
# breaks the URL instead of authenticating.
POSTGRES_USER=git_web_review
POSTGRES_PASSWORD=
POSTGRES_DB=git_web_review

# Redis is reachable only through Docker DNS, but a compromised container would
# otherwise get full access — including publishing forged notification events to
# the three relays. Generate with: openssl rand -hex 32
# This one is passed to the clients as its own variable, not inside a URL, so
# any character works — but keep it simple anyway.
REDIS_PASSWORD=

# Host ports. The backend listens on 3000 inside Docker but is exposed on 3005.
BACKEND_PORT=3005
# uid:gid the backend container runs as. It has to be able to read
# secrets/firebase-service-account.json, which keeps the host's ownership
# through the bind mount — so with a 600 key, set these to `id -u` and `id -g`.
# Defaults to the image's own unprivileged `node` user.
BACKEND_UID=
BACKEND_GID=
FRONTEND_PORT=5173
WEBSOCKET_RELAY_PORT=3001
HTTP_RELAY_PORT=3002

# Public URLs used by browser-side code.
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:3005
PUBLIC_FRONTEND_URL=http://localhost:5173
PUBLIC_WEBSOCKET_URL=ws://localhost:3001

# Optional HTTP Host allowlists. Leave empty to keep framework defaults/no filtering.
# Use comma-separated hosts; use * to allow every host.
FRONTEND_ALLOWED_HOSTS=
BACKEND_ALLOWED_HOSTS=
WEBSOCKET_ALLOWED_HOSTS=

# Bootstrap admin emails. Comma-separated list; matching users are promoted to ADMIN on login.
ADMINS=admin@company.tld,review-admin@company.tld

# Internal JWT auth. Lets agents and CI authenticate with service account
# credentials instead of Firebase. Generate with: openssl rand -base64 48
# Leave empty to disable the internal login flow entirely.
INTERNAL_JWT_SECRET=
# Lifetime of the tokens issued by POST /v1/auth/token, in seconds (60..86400).
INTERNAL_JWT_TTL_SECONDS=3600

# Rate limiting, per caller and per minute. A caller is the bearer token when
# there is one, and the IP address otherwise: a company behind a single NAT
# gateway would otherwise share one counter.
THROTTLE_DEFAULT_PER_MINUTE=300
# POST /v1/auth/token derives an scrypt hash on every call, unauthenticated.
THROTTLE_AUTH_PER_MINUTE=10
# Routes that trigger a `git fetch` towards a remote host.
THROTTLE_GIT_PER_MINUTE=20

# Set only when a trusted reverse proxy rewrites X-Forwarded-For, as a number of
# hops or an express `trust proxy` value. Without a proxy, leave it empty:
# enabling it lets anyone choose their own address, and so their own counter.
TRUST_PROXY=

# Git hosts the backend may contact when reading a review's source. Same
# spelling as the other allow-lists: empty or * allows every host, a listed host
# matches exactly, and a leading dot also covers subdomains. Empty by default
# because company forges often sit on private addresses, but an instance open to
# untrusted users should name its forges here.
GIT_ALLOWED_HOSTS=
# Concurrent git operations, all callers together. Each one reaches out to a
# remote host and holds a process for up to GIT_TIMEOUT_MS.
GIT_MAX_CONCURRENT=4
GIT_TIMEOUT_MS=120000

# Max uploaded profile image size in bytes.
PROFILE_IMAGE_MAX_BYTES=1048576

# Max uploaded application logo size in bytes.
APP_LOGO_MAX_BYTES=1048576

# Firebase Admin credentials are mounted from ./secrets/firebase-service-account.json.
# Keep this path aligned with docker-compose.yml.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=

# Sign-in providers trusted to assert the user's email without the
# `email_verified` claim. Empty by default: a token whose email is not verified
# is refused, because the allowed-domain check and the ADMIN role are both
# decided from that address.
# Only fill this in if your IdP guarantees the address but omits the claim, and
# list the Firebase provider ids exactly, e.g. oidc.acme,saml.company.
# Never list `password`: with it, anyone can claim any address.
FIREBASE_TRUSTED_SIGN_IN_PROVIDERS=

# Swagger UI and the raw OpenAPI document are served on /api and /api-json.
# They are off when NODE_ENV=production; set this to true to serve them anyway.
SWAGGER_ENABLED=

# Firebase web app config for the future frontend OAuth flow.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# IRC relay config.
IRC_DRY_RUN=true
IRC_HOST=irc.company.tld
IRC_PORT=6697
IRC_TLS=true
IRC_NICK=git-web-review
IRC_USERNAME=git-web-review
IRC_REALNAME=git-web-review notification relay
IRC_PASSWORD=

# Email relay config.
EMAIL_DRY_RUN=true
SMTP_HOST=smtp.company.tld
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# The relay requires STARTTLS by default, so credentials never travel in clear
# against a server that does not advertise it. Only set this if your SMTP relay
# genuinely has no TLS and sits on a trusted network.
SMTP_ALLOW_PLAINTEXT=false
MAIL_FROM=git-web-review@company.tld

# HTTP relay config. Posts each notification to the webhook URL every user
# configures in their own settings, so there is no global endpoint here.
HTTP_RELAY_DRY_RUN=true
WEBHOOK_WORKERS=4
WEBHOOK_QUEUE_SIZE=1024
WEBHOOK_TIMEOUT=10s
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_RETRY_BASE_DELAY=1s
WEBHOOK_RETRY_MAX_DELAY=30s
# Restrict where users may point their webhooks.
# Use comma-separated hosts; use * to allow every host, as does leaving it empty.
# A listed host also matches its subdomains.
WEBHOOK_ALLOWED_HOSTS=
# Refuse targets resolving to loopback, private or link-local addresses.
# On by default: the URL comes from a user's own settings and the relay calls it
# from inside the Docker network, where postgres and redis live. Set it to false
# only if your notification endpoints are genuinely on a private address, and
# pair that with a WEBHOOK_ALLOWED_HOSTS list.
# Read by both the http-relay, which enforces it on the resolved IP at delivery
# time, and the backend, which rejects a disallowed URL when it is saved.
WEBHOOK_BLOCK_PRIVATE_NETWORKS=true
